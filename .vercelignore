# В деплой уходят dist/ (сайт) и api/ (функция заявок) — всё остальное нужно
# лишь для локальной сборки. api/ и package.json исключать нельзя: без них
# не будет функции /api/booking ("type": "module" нужен для её запуска).
node_modules
src
build.mjs
qa.mjs
dev-server.mjs
package-lock.json
README.md

# Копии сборки рядом с исходниками (build.mjs пишет их для открытия двойным кликом)
/index.html
/assets
