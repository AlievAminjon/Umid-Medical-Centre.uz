{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'skip: зависимости нужны только для локальной сборки'",
  "buildCommand": "echo 'skip: dist собран локально через npm run build'",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:lang(ru|uz|en|es|fr|de)", "destination": "/index.html" },
    { "source": "/:lang(ru|uz|en|es|fr|de)/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
